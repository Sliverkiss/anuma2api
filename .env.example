# =============================================================================
# Anuma 2API — 环境配置模板（复制为 .env 后填写真实值）
# =============================================================================
# 此文件只含占位符，不含任何真实凭据。复制为 .env 后：
#   cp .env.example .env  &&  vim .env
# .env 已被 .gitignore 排除，不会推送到 GitHub。

# -----------------------------------------------------------------------------
# 注册脚本 register.py（cf-temp-mail 临时邮箱）
# -----------------------------------------------------------------------------
# 临时邮箱 API base（默认 https://YOUR_MAIL_DOMAIN）
CF_TEMP_MAIL_API=https://YOUR_MAIL_DOMAIN
# 建箱鉴权 key（必填，来自 cf-temp-mail skill / ~/.hermes/.env）
CF_TEMP_MAIL_KEY=YOUR_MAIL_KEY
# 邮箱域名（默认 YOUR_MAIL_DOMAIN）
CF_TEMP_MAIL_DOMAIN=YOUR_MAIL_DOMAIN

# -----------------------------------------------------------------------------
# 注册脚本 register.py（临时邮箱提供商选择）
# -----------------------------------------------------------------------------
# 临时邮箱提供商: cftemp (默认, cf-temp-mail) | yydsmail (YYDS Mail)
MAIL_PROVIDER=cftemp
# YYDS Mail API key（MAIL_PROVIDER=yydsmail 时必填）
YYDS_MAIL_API_KEY=YOUR_YYDS_MAIL_API_KEY
# YYDS Mail API base（默认 https://maliapi.215.im/v1）
YYDS_MAIL_BASE_URL=https://maliapi.215.im/v1
# YYDS Mail 域名（可选）
YYDS_MAIL_DOMAIN=
# YYDS Mail 子域名（可选）
YYDS_MAIL_SUBDOMAIN=
# YYDS Mail 通配符建箱（可选, true/false）
YYDS_MAIL_WILDCARD=false

# -----------------------------------------------------------------------------
# 注册脚本 register.py（网关上传）
# -----------------------------------------------------------------------------
# 网关地址（默认 http://127.0.0.1:7895）
ANUMA_GATEWAY_URL=http://127.0.0.1:7895
# 网关管理 Bearer token（必须与网关 ANUMA_ADMIN_PASSWORD 一致）
ANUMA_GATEWAY_TOKEN=YOUR_GATEWAY_TOKEN

# -----------------------------------------------------------------------------
# 网关 gateway（docker-compose / 本地启动共用）
# -----------------------------------------------------------------------------
# API 访问密码（Bearer token）——部署前【必须】改成强随机值
ANUMA_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
# HTTP 监听端口（默认 7895）
ANUMA_PORT=7895
# SQLite 持久化路径（默认 ./gateway.db；容器内 /app/data/gateway.db）
ANUMA_DB_PATH=./gateway.db
# 模型列表缓存秒数（默认 600）
ANUMA_MODEL_CACHE_TTL=600
# 上游地址（默认 https://portal.anuma.ai/api/v1）
ANUMA_UPSTREAM_BASE_URL=https://portal.anuma.ai/api/v1
# privy 续期地址（默认 https://auth.privy.io/api/v1）
ANUMA_PRIVY_BASE_URL=https://auth.privy.io/api/v1
# 每次请求的换号/重试预算（默认 3）
ANUMA_MAX_RETRIES=3
# 连续鉴权失败上限（默认 3）
ANUMA_AUTH_FAIL_LIMIT=3
# 模型白名单（逗号分隔；默认 12 个可用模型，见 README.md）
ANUMA_MODEL_ALLOWLIST=inclusionai/ling-2.6-flash,openai/gpt-5.6-luna,qwen/qwen-3.6-plus,minimax/minimax-m2.5,anthropic/claude-sonnet-5,gemini/gemini-3.1-pro-preview,gemini/gemini-3-flash-preview,grok/grok-4.5,glm/glm-5.2,kimi/kimi-k3,minimax/minimax-m3,qwen/qwen-3.7-plus
# 后台 token 巡检间隔（秒，默认 86400；<=0 禁用）
ANUMA_REFRESH_INTERVAL=86400
# 后台 cooldown 巡检间隔（秒，默认 86400；<=0 禁用）
ANUMA_COOLDOWN_CHECK_INTERVAL=86400
# 重试退避基数（毫秒，默认 200）
ANUMA_RETRY_BACKOFF_MS=200
